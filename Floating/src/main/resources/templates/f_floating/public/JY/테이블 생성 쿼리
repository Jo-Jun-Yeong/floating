-- 1️⃣ USER (예약어이므로 백틱 사용)
CREATE TABLE `USER` (
    User_ID BIGINT NOT NULL AUTO_INCREMENT,
    Password VARCHAR(20) NOT NULL,
    Email VARCHAR(50) NOT NULL,
    PRIMARY KEY(User_ID),
    CONSTRAINT UK_EMAIL UNIQUE (Email)
);

-- 2️⃣ USER_PRIVACY
CREATE TABLE USER_PRIVACY (
    User_ID BIGINT NOT NULL,
    Phone VARCHAR(15) NOT NULL,
    Phone2 VARCHAR(15),
    Birth DATETIME NOT NULL,
    PRIMARY KEY(User_ID),
    CONSTRAINT FK_USER_PRIVACY FOREIGN KEY (User_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE,
    CONSTRAINT UK_USER_PRIVACY_PHONE UNIQUE (Phone)
);

-- 3️⃣ USER_PROFILE
CREATE TABLE USER_PROFILE (
    User_ID BIGINT NOT NULL,
    User_Name VARCHAR(20) NOT NULL,
    User_NickName VARCHAR(20),
    Gender VARCHAR(1),
    ProfileImage VARCHAR(255),
    Self_Comment VARCHAR(200),
    PRIMARY KEY(User_ID),
    CONSTRAINT FK_PROFILE_USERID FOREIGN KEY (User_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE
);

-- 4️⃣ MESSAGE_ROOM (참조 대상이므로 MESSAGE보다 먼저 생성)
CREATE TABLE MESSAGE_ROOM (
    Room_ID BIGINT NOT NULL AUTO_INCREMENT,
    Room_Name VARCHAR(50),
    Created_At DATETIME NOT NULL,
    PRIMARY KEY(Room_ID)
);

-- 5️⃣ MESSAGE
CREATE TABLE MESSAGE (
    Message_ID BIGINT NOT NULL AUTO_INCREMENT,
    Room_ID BIGINT NOT NULL,
    Sender_ID BIGINT NOT NULL,
    Receiver_ID BIGINT NOT NULL,
    Sent_At DATETIME NOT NULL,
    Text VARCHAR(255) NOT NULL,
    Status VARCHAR(15) NOT NULL,
    PRIMARY KEY(Message_ID),
    CONSTRAINT FK_MESSAGE_SENDER FOREIGN KEY (Sender_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE,
    CONSTRAINT FK_MESSAGE_RECEIVER FOREIGN KEY (Receiver_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE,
    CONSTRAINT FK_MESSAGE_ROOM FOREIGN KEY (Room_ID)
        REFERENCES MESSAGE_ROOM (Room_ID)
        ON DELETE CASCADE
);

-- 6️⃣ STORYMAIN (오타 수정, 만료시간 포함)
CREATE TABLE STORYMAIN (
    Story_ID BIGINT NOT NULL AUTO_INCREMENT,
    User_ID BIGINT NOT NULL,
    LikeCount INT NOT NULL DEFAULT 0,
    CommentCount INT NOT NULL DEFAULT 0,
    Create_At DATETIME NOT NULL,
    Expires_At DATETIME,
    Content VARCHAR(1000) NOT NULL,
    PRIMARY KEY(Story_ID),
    CONSTRAINT FK_STORY_USER FOREIGN KEY (User_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE
);

-- 7️⃣ STORYBUBBLE
CREATE TABLE STORYBUBBLE (
    Story_ID BIGINT NOT NULL,
    User_ID BIGINT NOT NULL,
    Viewed_At DATETIME,
    PRIMARY KEY(Story_ID, User_ID),
    CONSTRAINT FK_BUBBLE_STORY_ID FOREIGN KEY (Story_ID)
        REFERENCES STORYMAIN (Story_ID)
        ON DELETE CASCADE,
    CONSTRAINT FK_BUBBLE_USERID FOREIGN KEY (User_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE
);

-- 8️⃣ COMMENT
CREATE TABLE COMMENT (
    Comment_ID BIGINT NOT NULL AUTO_INCREMENT,
    Parent_Comment_ID BIGINT,
    Story_ID BIGINT NOT NULL,
    User_ID BIGINT NOT NULL,
    Comment VARCHAR(300) NOT NULL,
    Created_At DATETIME NOT NULL,
    PRIMARY KEY(Comment_ID),
    CONSTRAINT FK_PARENT_COMMENT FOREIGN KEY (Parent_Comment_ID)
        REFERENCES COMMENT (Comment_ID)
        ON DELETE CASCADE,
    CONSTRAINT FK_COMMENT_STORY FOREIGN KEY (Story_ID)
        REFERENCES STORYMAIN (Story_ID)
        ON DELETE CASCADE,
    CONSTRAINT FK_COMMENT_USER FOREIGN KEY (User_ID)
        REFERENCES `USER` (User_ID)
        ON DELETE CASCADE
);
